# Always target the ESP32-S3
CONFIG_IDF_TARGET="esp32s3"

# ESP32-S3 N16R8 — 16MB flash, 8MB octal PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Octal PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_USE_MALLOC=y

# Custom partition table (16MB)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# HTTP server: allow longer URIs and a few more handlers
CONFIG_HTTPD_MAX_URI_LEN=1024

# Larger main task stack for the build/flash worker paths
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Native USB (GPIO19/20) as a PicoFlasher-compatible CDC device for J-Runner.
# Console stays on UART0 (the COM port you flash through).
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_TX_BUFSIZE=2048
